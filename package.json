{
  "name": "beautice-learning-lab",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:css": "npm run dev --workspace @beautice/react-css",
    "build:css": "npm run build --workspace @beautice/react-css",
    "lint:css": "npm run lint --workspace @beautice/react-css",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
